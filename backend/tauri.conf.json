{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAS Sync",
  "version": "0.9.0",
  "identifier": "com.nasos.sync",
  "build": {
    "beforeBuildCommand": "npm run build:tauri",
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist/tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NAS Sync",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "mini",
        "title": "NAS Sync",
        "url": "index.html#mini",
        "width": 360,
        "height": 480,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws://127.0.0.1:1420 ws://localhost:1420; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "targets": "all",
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  }
}
