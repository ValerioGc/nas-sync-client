{
  "name": "nas-sync-client",
  "private": true,
  "type": "module",
  "version": "0.9.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "build": "vue-tsc --build && vite build",
    "build-only": "vite build",
    "coverage:rust": "node -e \"require('fs').mkdirSync('backend/coverage',{recursive:true})\" && cargo llvm-cov --manifest-path backend/Cargo.toml --lcov --output-path backend/coverage/lcov.info",
    "dev": "vite",
    "podman:sonar:down": "podman compose -f podman-compose.sonar.yml down",
    "podman:sonar:logs": "podman compose -f podman-compose.sonar.yml logs -f",
    "podman:sonar:up": "podman compose -f podman-compose.sonar.yml up -d",
    "format": "prettier --write . && node scripts/pipeline/format-sfc-spacing.mjs && eslint . --fix",
    "format:check": "prettier --check . \"!src/**/*.vue\" && node scripts/pipeline/format-sfc-spacing.mjs --check",
    "format:sfc": "node scripts/pipeline/format-sfc-spacing.mjs",
    "lint": "run-s \"lint:*\"",
    "lint:eslint": "eslint .",
    "preview": "vite preview",
    "tauri": "node scripts/build/tauri.mjs",
    "tauri:build": "npm run tauri -- build",
    "tauri:dev": "npm run tauri -- dev",
    "engine:fetch": "node scripts/build/engine.mjs",
    "test": "vitest run --passWithNoTests",
    "test:component": "vitest run tests/component --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:allure": "allure generate tests/e2e/allure-results --output tests/e2e/allure-report",
    "test:e2e:allure:open": "allure open tests/e2e/allure-report",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:sonar": "npm run test:coverage && npm run coverage:rust && cargo clippy --manifest-path backend/Cargo.toml --all-targets --message-format=json > backend/clippy-report.json && podman run --rm --userns=keep-id:uid=1000,gid=1000 --network=host -e SONAR_TOKEN -e SONAR_HOST_URL=http://127.0.0.1:9000 -v \"$PWD:/usr/src:Z\" docker.io/sonarsource/sonar-scanner-cli",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "release:test": "node scripts/pipeline/prepare_release.mjs",
    "release:merge": "node scripts/pipeline/merge_release.mjs",
    "release:check": "node scripts/pipeline/verify_release.mjs",
    "release:test:unit": "node --test tests/pipeline/*.test.mjs",
    "type-check": "vue-tsc --build",
    "build:tauri": "npm run build",
    "dev:tauri": "npm run dev",
    "preview:tauri": "npm run preview",
    "test:build": "npm run build && npm run test:build:check",
    "test:build:check": "node --test tests/build/*.test.mjs",
    "lock:npm": "node scripts/npm-lock.mjs --sync",
    "postinstall": "node scripts/npm-lock.mjs --sync",
    "lint:lock": "node scripts/npm-lock.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/compiler-core": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "allure": "^3.21.0",
    "allure-playwright": "^3.13.0",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.8.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "playwright-bdd": "^9.2.1",
    "postcss": "^8.5.30",
    "postcss-combine-duplicated-selectors": "^11.0.0",
    "prettier": "3.9.10",
    "sass": "^1.105.2",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
